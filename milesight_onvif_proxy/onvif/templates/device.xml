{% macro device_information(cam) %}
<tds:GetDeviceInformationResponse>
  <tds:Manufacturer>{{ cam.channel.camera.manufacturer or "Milesight" }}</tds:Manufacturer>
  <tds:Model>{{ cam.channel.camera.model or "NVR Channel" }}</tds:Model>
  <tds:FirmwareVersion>{{ cam.channel.camera.firmware or "1.0" }}</tds:FirmwareVersion>
  <tds:SerialNumber>{{ cam.channel.camera.serial or cam.device_uuid }}</tds:SerialNumber>
  <tds:HardwareId>{{ cam.channel.camera.mac or ("CH" ~ cam.number) }}</tds:HardwareId>
</tds:GetDeviceInformationResponse>
{% endmacro %}

{% macro capabilities(cam) %}
<tds:GetCapabilitiesResponse>
  <tds:Capabilities>
    <tt:Device><tt:XAddr>{{ cam.base_url }}/onvif/device_service</tt:XAddr></tt:Device>
    <tt:Events>
      <tt:XAddr>{{ cam.base_url }}/onvif/event_service</tt:XAddr>
      <tt:WSSubscriptionPolicySupport>false</tt:WSSubscriptionPolicySupport>
      <tt:WSPullPointSupport>true</tt:WSPullPointSupport>
      <tt:WSPausableSubscriptionManagerInterfaceSupport>false</tt:WSPausableSubscriptionManagerInterfaceSupport>
    </tt:Events>
    <tt:Media>
      <tt:XAddr>{{ cam.base_url }}/onvif/media_service</tt:XAddr>
      <tt:StreamingCapabilities>
        <tt:RTPMulticast>false</tt:RTPMulticast>
        <tt:RTP_TCP>true</tt:RTP_TCP>
        <tt:RTP_RTSP_TCP>true</tt:RTP_RTSP_TCP>
      </tt:StreamingCapabilities>
    </tt:Media>
  </tds:Capabilities>
</tds:GetCapabilitiesResponse>
{% endmacro %}

{% macro services(cam, include_capability) %}
<tds:GetServicesResponse>
  {% for ns, path in [("http://www.onvif.org/ver10/device/wsdl", "device_service"), ("http://www.onvif.org/ver10/media/wsdl", "media_service"), ("http://www.onvif.org/ver20/media/wsdl", "media2_service"), ("http://www.onvif.org/ver10/events/wsdl", "event_service")] %}
  <tds:Service>
    <tds:Namespace>{{ ns }}</tds:Namespace>
    <tds:XAddr>{{ cam.base_url }}/onvif/{{ path }}</tds:XAddr>
    <tds:Version><tt:Major>2</tt:Major><tt:Minor>6</tt:Minor></tds:Version>
  </tds:Service>
  {% endfor %}
</tds:GetServicesResponse>
{% endmacro %}

{% macro service_capabilities() %}
<tds:GetServiceCapabilitiesResponse>
  <tds:Capabilities>
    <tds:Network IPFilter="false" ZeroConfiguration="false" IPVersion6="false" DynDNS="false"/>
    <tds:Security UsernameToken="true" HttpDigest="false" RELToken="false"/>
    <tds:System DiscoveryResolve="false" DiscoveryBye="false" RemoteDiscovery="false" SystemBackup="false" SystemLogging="false" FirmwareUpgrade="false"/>
  </tds:Capabilities>
</tds:GetServiceCapabilitiesResponse>
{% endmacro %}

{% macro system_date_time(now) %}
<tds:GetSystemDateAndTimeResponse>
  <tds:SystemDateAndTime>
    <tt:DateTimeType>NTP</tt:DateTimeType>
    <tt:DaylightSavings>false</tt:DaylightSavings>
    <tt:TimeZone><tt:TZ>UTC0</tt:TZ></tt:TimeZone>
    <tt:UTCDateTime>
      <tt:Time><tt:Hour>{{ now.hour }}</tt:Hour><tt:Minute>{{ now.minute }}</tt:Minute><tt:Second>{{ now.second }}</tt:Second></tt:Time>
      <tt:Date><tt:Year>{{ now.year }}</tt:Year><tt:Month>{{ now.month }}</tt:Month><tt:Day>{{ now.day }}</tt:Day></tt:Date>
    </tt:UTCDateTime>
  </tds:SystemDateAndTime>
</tds:GetSystemDateAndTimeResponse>
{% endmacro %}

{% macro scopes(cam) %}
<tds:GetScopesResponse>
  {% for scope in ["onvif://www.onvif.org/type/video_encoder", "onvif://www.onvif.org/Profile/Streaming", "onvif://www.onvif.org/name/" ~ (cam.name | urlencode), "onvif://www.onvif.org/hardware/" ~ ((cam.channel.camera.model or "channel") | urlencode)] %}
  <tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>{{ scope }}</tt:ScopeItem></tds:Scopes>
  {% endfor %}
</tds:GetScopesResponse>
{% endmacro %}

{% macro hostname(cam) %}
<tds:GetHostnameResponse>
  <tds:HostnameInformation><tt:FromDHCP>false</tt:FromDHCP><tt:Name>{{ cam.name }}</tt:Name></tds:HostnameInformation>
</tds:GetHostnameResponse>
{% endmacro %}
